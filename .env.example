# Get your API key from https://krea.ai (Settings > API)
KREA_API_KEY=your_api_key_here

# FTP configuration for uploading local images (required for upscaling local files)
FTP_HOST=your.ftp.server
FTP_PORT=21
FTP_USER=username
FTP_PASS=password
FTP_REMOTE_PATH=/path/to/upload/
FTP_PUBLIC_URL=https://your.domain/path/to/upload/
